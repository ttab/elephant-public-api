    "/twirp/elephant.live.Blogs/UpdateBlog": {
      "post": {
        "description": "UpdateBlog updates the mutable metadata of an existing blog.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/elephant.live.UpdateBlogRequest"
              }
            }
          }
        },
