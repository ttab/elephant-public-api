          },
          "description": {
            "description": "Description of the blog.",
            "type": "string"
          },
          "id": {
            "description": "Id of the blog to update.",
            "type": "string"
          },
          "language": {
            "description": "Language is the BCP 47 language tag of the blog contents.",
            "type": "string"
          },
          "title": {
            "description": "Title of the blog.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.UpdateBlogResponse": {
        "properties": {
          "blog": {
            "$ref": "#/components/schemas/elephant.live.Blog"
          }
        },
        "type": "object"
      },
      "elephant.live.UpdatePostRequest": {
        "properties": {
          "blog_id": {
            "description": "BlogId of the post's blog.",
            "type": "string"
          },
          "content": {
            "$ref": "#/components/schemas/newsdoc.Document"
          },
          "flags": {
            "description": "Flags are free-form labels attached to the post.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "Id of the post to update.",
            "type": "integer"
          },
          "pin_priority": {
            "description": "PinPriority pins the post when greater than zero.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.UpdatePostResponse": {
        "properties": {
