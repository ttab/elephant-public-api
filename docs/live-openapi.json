  "tags": [
    {
      "description": "Blogs is the administrative RPC surface for managing live blogs. All methods require an authenticated caller; mutating methods additionally require the \"liveblog_write\" scope, read methods accept \"liveblog_read\" or \"liveblog_write\".",
      "name": "Blogs"
    },
    {
      "description": "Posts is the administrative RPC surface for managing the posts of a live blog. Mutating methods require the \"liveblog_write\" scope.",
      "name": "Posts"
    },
    {
      "description": "Configuration manages the post validation configuration: immutable revisor schema specs and activatable configuration generations that select a schema set and the document types accepted as post content. Mutating methods require the \"liveblog_admin\" scope; read methods also accept \"liveblog_read\" or \"liveblog_write\".",
      "name": "Configuration"
    }
  ]
