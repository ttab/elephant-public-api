{
  "components": {
    "schemas": {
      "elephant.live.ActivateConfigGenerationRequest": {
        "properties": {
          "id": {
            "description": "Id of the generation to activate.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.ActivateConfigGenerationResponse": {
        "properties": {
          "generation": {
            "$ref": "#/components/schemas/elephant.live.ConfigGeneration"
          }
        },
        "type": "object"
      },
      "elephant.live.Blog": {
        "description": "Blog is a live blog and its metadata.",
        "properties": {
          "active": {
            "description": "Active marks whether the blog is currently running.",
            "type": "boolean"
          },
          "created": {
            "description": "Created is the RFC3339 creation timestamp.",
            "type": "string"
          },
          "created_by": {
            "description": "CreatedBy is the subject that created the blog.",
            "type": "string"
          },
          "description": {
            "description": "Description of the blog.",
            "type": "string"
          },
          "id": {
            "description": "Id is the blog UUID.",
            "type": "string"
          },
          "language": {
            "description": "Language is the BCP 47 language tag of the blog contents.",
            "type": "string"
          },
          "title": {
            "description": "Title of the blog.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.ConfigGeneration": {
        "description": "ConfigGeneration is a registered post validation configuration snapshot.",
        "properties": {
          "activated_at": {
            "description": "ActivatedAt is the time the generation was last activated, RFC3339, or empty if it has never been activated.",
            "type": "string"
          },
          "active": {
            "description": "Active is true for the currently active generation.",
            "type": "boolean"
          },
          "created_at": {
            "description": "CreatedAt is the time of registration, RFC3339.",
            "type": "string"
          },
          "description": {
            "description": "Description is an optional human-readable tag.",
            "type": "string"
          },
          "id": {
            "description": "Id is assigned by the server on registration.",
            "type": "integer"
          },
          "post_types": {
            "description": "PostTypes are the document types accepted as post content.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schemas": {
            "description": "Schemas in the generation, in registration order. Not populated by ListConfigGenerations.",
            "items": {
              "$ref": "#/components/schemas/elephant.live.ConfigGenerationSchema"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "elephant.live.ConfigGenerationSchema": {
        "description": "ConfigGenerationSchema references a schema version included in a generation. Spec is optional when the version is already stored; it is required when registering a new (name, version) pair.",
        "properties": {
          "name": {
            "description": "Name of the schema.",
            "type": "string"
          },
          "spec": {
            "description": "Spec is the revisor constraint-set JSON.",
            "type": "string"
          },
          "version": {
            "description": "Version is the semver version of the schema, stored canonicalised.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.CreateBlogRequest": {
        "properties": {
          "active": {
            "description": "Active marks whether the blog starts out running.",
            "type": "boolean"
          },
          "description": {
            "description": "Description of the blog.",
            "type": "string"
          },
          "language": {
            "description": "Language is the BCP 47 language tag of the blog contents.",
            "type": "string"
          },
          "title": {
            "description": "Title of the blog. The blog id is always generated by the server.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.CreateBlogResponse": {
        "properties": {
          "blog": {
            "$ref": "#/components/schemas/elephant.live.Blog"
          }
        },
        "type": "object"
      },
      "elephant.live.CreatePostRequest": {
        "properties": {
          "blog_id": {
            "description": "BlogId of the blog to append to.",
            "type": "string"
          },
          "content": {
            "$ref": "#/components/schemas/newsdoc.Document"
          },
          "flags": {
            "description": "Flags are free-form labels attached to the post.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "idempotency_key": {
            "description": "IdempotencyKey is an optional client-generated key (unique per blog, at most 128 characters) that makes retries safe: repeating a CreatePost with the same key returns the post created by the first request instead of creating a duplicate.",
            "type": "string"
          },
          "pin_priority": {
            "description": "PinPriority pins the post when greater than zero.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.CreatePostResponse": {
        "properties": {
          "post": {
            "$ref": "#/components/schemas/elephant.live.Post"
          }
        },
        "type": "object"
      },
      "elephant.live.DeleteBlogRequest": {
        "properties": {
          "id": {
            "description": "Id of the blog to delete.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.DeleteBlogResponse": {
        "type": "object"
      },
      "elephant.live.DeletePostRequest": {
        "properties": {
          "blog_id": {
            "description": "BlogId of the post's blog.",
            "type": "string"
          },
          "id": {
            "description": "Id of the post to delete.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.DeletePostResponse": {
        "type": "object"
      },
      "elephant.live.GetActiveConfigGenerationRequest": {
        "properties": {
          "known_id": {
            "description": "KnownId is the generation id the client already has; the call returns immediately when the active generation differs. Optional.",
            "type": "integer"
          },
          "only_changed": {
            "description": "OnlyChanged returns an empty response (with Unchanged=true) if the active generation matches KnownId.",
            "type": "boolean"
          },
          "wait_seconds": {
            "description": "WaitSeconds is the maximum number of seconds to wait for the active generation to differ from KnownId. Defaults to 10. Optional.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.GetActiveConfigGenerationResponse": {
        "properties": {
          "generation": {
            "$ref": "#/components/schemas/elephant.live.ConfigGeneration"
          },
          "unchanged": {
            "description": "Unchanged is true if KnownId matched the active generation and OnlyChanged was set.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "elephant.live.GetBlogRequest": {
        "properties": {
          "id": {
            "description": "Id of the blog to fetch.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.GetBlogResponse": {
        "properties": {
          "blog": {
            "$ref": "#/components/schemas/elephant.live.Blog"
          }
        },
        "type": "object"
      },
      "elephant.live.GetPostRequest": {
        "properties": {
          "blog_id": {
            "description": "BlogId of the post's blog.",
            "type": "string"
          },
          "id": {
            "description": "Id of the post to fetch.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.GetPostResponse": {
        "properties": {
          "post": {
            "$ref": "#/components/schemas/elephant.live.Post"
          }
        },
        "type": "object"
      },
      "elephant.live.GetSchemaRequest": {
        "properties": {
          "name": {
            "description": "Name of the schema to get.",
            "type": "string"
          },
          "version": {
            "description": "Version of the schema to get; empty resolves to the version in the active generation.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.GetSchemaResponse": {
        "properties": {
          "spec": {
            "description": "Spec is the revisor constraint-set JSON.",
            "type": "string"
          },
          "version": {
            "description": "Version of the returned schema.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.ListBlogsRequest": {
        "properties": {
          "limit": {
            "description": "Limit caps the number of blogs returned. The server applies a default and maximum when zero or too large.",
            "type": "integer"
          },
          "offset": {
            "description": "Offset skips this many blogs from the start of the (newest first) result, for page-numbered pagination.",
            "type": "integer"
          },
          "only_active": {
            "description": "OnlyActive restricts the result to running blogs.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "elephant.live.ListBlogsResponse": {
        "properties": {
          "blogs": {
            "description": "Blogs is the list of blogs, newest first.",
            "items": {
              "$ref": "#/components/schemas/elephant.live.Blog"
            },
            "type": "array"
          },
          "total": {
            "description": "Total is the total number of blogs matching the request, ignoring limit and offset, so clients can compute the number of pages.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.ListConfigGenerationsRequest": {
        "properties": {
          "before": {
            "description": "Before is the highest generation id to return; defaults to the latest. Use the smallest returned id to paginate further into the past.",
            "type": "integer"
          },
          "page_size": {
            "description": "PageSize defaults to 50, max 200.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.ListConfigGenerationsResponse": {
        "properties": {
          "generations": {
            "description": "Generations without schemas populated, newest first.",
            "items": {
              "$ref": "#/components/schemas/elephant.live.ConfigGeneration"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "elephant.live.ListPinnedPostsRequest": {
        "properties": {
          "blog_id": {
            "description": "BlogId of the blog to list pinned posts for.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "elephant.live.ListPinnedPostsResponse": {
        "properties": {
          "posts": {
            "description": "Posts are the pinned posts, highest priority first.",
            "items": {
              "$ref": "#/components/schemas/elephant.live.Post"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "elephant.live.ListPostsRequest": {
        "properties": {
          "before_id": {
            "description": "BeforeId is an exclusive cursor; only posts with a lower id are returned. Zero starts from the newest post.",
            "type": "integer"
          },
          "blog_id": {
            "description": "BlogId of the blog to list posts for.",
            "type": "string"
          },
          "limit": {
            "description": "Limit caps the number of posts returned. The server applies a default and maximum when zero or too large.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.ListPostsResponse": {
        "properties": {
          "has_more": {
            "description": "HasMore is true when older posts exist beyond the returned page.",
            "type": "boolean"
          },
          "posts": {
            "description": "Posts are the matching posts, newest first.",
            "items": {
              "$ref": "#/components/schemas/elephant.live.Post"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "elephant.live.Post": {
        "description": "Post is a single entry in a live blog.",
        "properties": {
          "content": {
            "$ref": "#/components/schemas/newsdoc.Document"
          },
          "created": {
            "description": "Created is the RFC3339 creation timestamp.",
            "type": "string"
          },
          "flags": {
            "description": "Flags are free-form labels attached to the post.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "Id is the sequential per-blog post id.",
            "type": "integer"
          },
          "pin_priority": {
            "description": "PinPriority pins the post when greater than zero; higher sorts first.",
            "type": "integer"
          },
          "updated": {
            "description": "Updated is the RFC3339 timestamp of the last update.",
            "type": "string"
          },
          "version": {
            "description": "Version increments every time the post is updated.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.RegisterConfigGenerationRequest": {
        "properties": {
          "activate": {
            "description": "Activate the new generation immediately. Defaults to false; callers typically register first and activate as a separate step so they can inspect the result first.",
            "type": "boolean"
          },
          "description": {
            "description": "Description is an optional human-readable tag for the new generation.",
            "type": "string"
          },
          "post_types": {
            "description": "PostTypes are the document types accepted as post content, at least one. Every type must be declared by the schemas.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schemas": {
            "description": "Schemas the generation should contain, at least one. Order is preserved.",
            "items": {
              "$ref": "#/components/schemas/elephant.live.ConfigGenerationSchema"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "elephant.live.RegisterConfigGenerationResponse": {
        "properties": {
          "generation": {
            "$ref": "#/components/schemas/elephant.live.ConfigGeneration"
          }
        },
        "type": "object"
      },
      "elephant.live.SetPinPriorityRequest": {
        "properties": {
          "blog_id": {
            "description": "BlogId of the post's blog.",
            "type": "string"
          },
          "id": {
            "description": "Id of the post to pin or unpin.",
            "type": "integer"
          },
          "pin_priority": {
            "description": "PinPriority to set; zero unpins the post.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "elephant.live.SetPinPriorityResponse": {
        "properties": {
          "post": {
            "$ref": "#/components/schemas/elephant.live.Post"
          }
        },
        "type": "object"
      },
      "elephant.live.UpdateBlogRequest": {
        "properties": {
